{
  "name": "delta",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "test": "bun test",
    "start": "bun run index.ts",
    "build": "bun build ./index.ts --compile --outfile delta",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint:toml": "taplo lint",
    "format:toml": "taplo format",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run lint && bun run lint:toml && bun test",
    "changelog": "auto-changelog --template keepachangelog --output CHANGELOG.md --unreleased --tag-prefix v --commit-limit false --ignore-commit-pattern \"^chore|^docs|^ci|^test\" --hide-empty-releases --hide-credit"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@octokit/rest": "^22.0.1",
    "commander": "^15.0.0",
    "picocolors": "^1.1.1",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@evilmartians/lefthook": "^2.1.10",
    "@taplo/cli": "^0.7.0",
    "@types/bun": "^1.3.14",
    "auto-changelog": "^2.6.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "typescript": "^7.0.2"
  }
}
